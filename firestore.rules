rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.paymentStatus == "unpaid"
                    && request.resource.data.hasLifetimeAccess == false
                    && request.resource.data.premium_active == false;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      "paymentStatus",
                      "hasLifetimeAccess",
                      "premium_active",
                      "uid",
                      "email",
                      "createdAt",
                      "trialStartDate",
                      "trialExpiresAt",
                      "purchaseDate",
                      "stripeCustomerId",
                      "stripeSessionId",
                      "purchaseEmail"
                    ]);

      allow delete: if false;

      // Payment history is written only by Cloud Functions (Admin SDK);
      // the owning user may read their own receipts.
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Lifetime Membership entitlements are keyed by the purchase email so
    // anonymous purchases can be claimed by a later matching sign-in.
    // Only Cloud Functions (Admin SDK) may write; clients may only read
    // their own authenticated account's entitlement record.
    match /entitlements/{email} {
      // Entitlements are server-side only. The client never reads Firestore
      // directly -- it polls status through the startOrRestoreTrial /
      // checkEntitlementByEmail / checkEntitlementForSignedInUser callable
      // functions (Cloud Functions use the Admin SDK, which bypasses these
      // rules). This keeps the client's only dependency on entitlement data
      // as a narrow, server-validated boolean response instead of direct
      // document access.
      allow read: if false;
      allow write: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}